{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023", "ESNext.Disposable"], "types": ["@cloudflare/workers-types", "node"],
    "strict": true, "skipLibCheck": true, "noEmit": true, "esModuleInterop": true, "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
