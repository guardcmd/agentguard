{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guardcmd-agentguard",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "agentguard-competition"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKSPACE",
        "class_name": "Workspace"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Workspace"
      ]
    }
  ],
  "vars": {
    "GUARD_MODE": "shadow",
    "AI_MODEL": "@cf/qwen/qwen2.5-coder-32b-instruct"
  },
  "limits": {
    "cpu_ms": 30000
  },
  "observability": {
    "enabled": true
  }
}
